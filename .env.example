# Modèle : copier ce fichier en .env.local et remplir les deux valeurs.
# .env.local n'est jamais envoyé sur GitHub.
# Les deux valeurs se trouvent dans Supabase > projet « voyage » > bouton « Connect » (en haut).

# Adresse du projet (Project URL), du type https://xxxx.supabase.co
VITE_SUPABASE_URL=

# Clé PUBLIQUE (publishable, commence par sb_publishable_…) ou ancienne clé « anon ».
# Jamais la clé secrète (sb_secret_… / service_role).
VITE_SUPABASE_PUBLISHABLE_KEY=
